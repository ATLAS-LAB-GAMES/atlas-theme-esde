<themeCapabilities>
  <themeName>ATLAS</themeName>

  <!-- ATLAS currently supports 4:3 and 16:9 landscape layouts. -->
  <aspectRatio>4:3</aspectRatio>
  <aspectRatio>16:9</aspectRatio>

  <transitions name="atlas-smooth">
    <label>ATLAS Smooth</label>
    <selectable>false</selectable>
    <systemToSystem>instant</systemToSystem>
    <systemToGamelist>fade</systemToGamelist>
    <gamelistToGamelist>instant</gamelistToGamelist>
    <gamelistToSystem>fade</gamelistToSystem>
    <startupToSystem>fade</startupToSystem>
    <startupToGamelist>fade</startupToGamelist>
  </transitions>
  <suppressTransitionProfiles>
    <entry>builtin-instant</entry>
    <entry>builtin-slide</entry>
    <entry>builtin-fade</entry>
  </suppressTransitionProfiles>

  <variant name="atlas-balanced">
    <label>Balanced</label>
    <selectable>true</selectable>
    <transitions>atlas-smooth</transitions>
  </variant>
  <variant name="atlas-dark">
    <label>Dark</label>
    <selectable>true</selectable>
    <transitions>atlas-smooth</transitions>
  </variant>
  <variant name="atlas-light">
    <label>Light</label>
    <selectable>true</selectable>
    <transitions>atlas-smooth</transitions>
  </variant>
  <variant name="atlas-vibrant">
    <label>Vibrant</label>
    <selectable>true</selectable>
    <transitions>atlas-smooth</transitions>
  </variant>
  <variant name="atlas-clean">
    <label>Clean</label>
    <selectable>true</selectable>
    <transitions>atlas-smooth</transitions>
  </variant>
</themeCapabilities>
